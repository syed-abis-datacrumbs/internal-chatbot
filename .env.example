# Gemini API Key — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Cloud API Token — from Meta Developer Dashboard
WHATSAPP_TOKEN=your_whatsapp_token_here

# Your WhatsApp Phone Number ID — from Meta Developer Dashboard
PHONE_NUMBER_ID=your_phone_number_id_here

# A secret string YOU choose — used to verify webhook with Meta
VERIFY_TOKEN=datacrumbs_bot_secret
